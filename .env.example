# Browser settings: never put database passwords in VITE_* variables.
VITE_AUTH_URL=/auth
VITE_AUTH_REALM=tunelab
VITE_AUTH_CLIENT_ID=tunelab-web
VITE_ENGINE_HOST=
# Vite (port 5174) proxies through the Docker frontend.
VITE_ENGINE_PROXY_TARGET=http://localhost:5173
VITE_AUTH_PROXY_TARGET=http://localhost:5173

FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
DEV_ORIGIN=http://localhost:5174
AUTH_PUBLIC_URL=http://localhost:5173/auth
# Hostname only, without https://; obtain it from the current Ubuntu cloudflared log.
TUNNEL_HOSTNAME=
# Addresses resolved INSIDE the frontend container, not in the browser.
ENGINE_UPSTREAM_SCHEME=http
ENGINE_UPSTREAM=host.docker.internal:8088
ENGINE_UPSTREAM_HOST=localhost
READY_UPSTREAM_SCHEME=http
READY_UPSTREAM=host.docker.internal:8000
BACKEND_DOCKER_NETWORK=slm-platform_slm-net

# PostgreSQL used only by Keycloak for account and realm data.
AUTH_DB_NAME=tunelab_auth
AUTH_DB_USER=tunelab
AUTH_DB_PASSWORD=
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
